# SellSync Frontend Environment Configuration
# Copy this file to .env and fill in your values

# Backend API Base URL - your friend's backend server
# Example: http://localhost:3000 or https://api.yourbackend.com
VITE_API_BASE_URL=http://localhost:3000

# Optional: API Authentication Token (if using JWT/session auth)
# VITE_API_TOKEN=your_auth_token_here

# Optional: Enable API debug mode (logs all requests)
# VITE_API_DEBUG=true
