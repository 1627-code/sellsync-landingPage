# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# JWT Secret for token generation (generate a random string)
